# Maintainer: Markuss Broks <king26022005@gmail.com>
pkgname=sloptube-git
_pkgname=sloptube
pkgver=r61.a5de3af
pkgrel=1
pkgdesc='Lightweight native YouTube and YouTube Music client (GTK4/libadwaita + GStreamer)'
arch=('x86_64' 'aarch64')
url='https://github.com/nergzd723/sloptube'
license=('GPL-3.0-or-later')
depends=(
  'gtk4' 'libadwaita' 'webkitgtk-6.0'
  'gstreamer' 'gst-plugins-base' 'gst-plugins-good'
  'gst-plugins-bad' 'gst-plugins-bad-libs'
  'yt-dlp' 'yt-dlp-ejs' 'deno'
  'sqlite' 'openssl' 'dbus'
)
makedepends=('git' 'cargo' 'pkgconf')
optdepends=(
  'gst-plugin-va: VA-API hardware decoding'
  'gnome-keyring: store the session in a keyring'
  'gst-libav: faster software decoding'
  'gst-plugin-dav1d: faster software AV1 decoding'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!lto' '!debug')
# Set SLOPTUBE_SRC=file:///path/to/checkout to package a local clone instead
source=("$_pkgname::git+${SLOPTUBE_SRC:-$url.git}")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release --workspace
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/sloptube -t "$pkgdir/usr/bin/"
  install -Dm644 data/io.github.nergzd.SlopTube.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 data/icons/scalable/apps/io.github.nergzd.SlopTube.svg \
    -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 data/icons/scalable/apps/io.github.nergzd.SlopTube-symbolic.svg \
    -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps/"
  # SlopTube Music (`sloptube --music`)
  install -Dm644 music/data/io.github.nergzd.SlopTubeMusic.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 music/data/icons/scalable/apps/io.github.nergzd.SlopTubeMusic.svg \
    -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 music/data/icons/scalable/apps/io.github.nergzd.SlopTubeMusic-symbolic.svg \
    -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps/"
}
